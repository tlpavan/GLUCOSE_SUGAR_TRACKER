{
  "name": "blood-sugar-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "vite": "6.4.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

