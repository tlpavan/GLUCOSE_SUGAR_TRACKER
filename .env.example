# Non-secret settings. Copy this file to ignored .env for local development.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
APP_TIME_ZONE=Asia/Kolkata

# REQUIRED: fill privately with a dedicated non-superuser local role.
# URL format: postgresql://<application-role>:<URL-encoded-password>@localhost:<port>/sweety_dev
# PostgreSQL 16 and 17 are both installed: use the PostgreSQL 17 service's port.
DATABASE_URL=

# REQUIRED: generate privately, at least 32 random bytes. Never paste into chat.
JWT_SECRET=

# Tests read ONLY ignored .env.test, not .env. Create .env.test with:
# NODE_ENV=test
# TEST_DATABASE_URL=<local application-role connection URL ending in /sweety_test>
# No JWT secret is needed in .env.test; tests generate an ephemeral one in memory.
TEST_DATABASE_URL=
